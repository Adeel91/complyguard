{
  "name": "complyguard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "scan": "tsx src/cli/index.ts scan",
    "check": "pnpm typecheck && pnpm lint && pnpm test:run",
    "deep-review": "tsx src/cli/deep-review.ts",
    "verify-remediation": "tsx src/cli/verify-remediation.ts",
    "deep-review:demo": "tsx src/cli/deep-review.ts demo/vulnerable-app --repository \"ComplyGuard vulnerable demo\" --frameworks gdpr,soc2,iso27001 --max-risks 8",
    "deep-review:demo:prompt": "tsx src/cli/deep-review.ts demo/vulnerable-app --repository \"ComplyGuard vulnerable demo\" --frameworks gdpr,soc2,iso27001 --max-risks 8 --prompt-only"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@fontsource/maple-mono": "^5.3.0",
    "adm-zip": "^0.6.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "commander": "^15.0.0",
    "lucide-react": "^1.31.0",
    "motion": "^13.1.0",
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.18.0",
    "tailwind-merge": "^3.6.0",
    "three": "^0.185.1",
    "ts-morph": "^28.0.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.185.4",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=24.0.0"
  }
}
